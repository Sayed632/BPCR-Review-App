# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is gitignored — never commit real keys.
#
# For Streamlit Cloud deployment: paste these same values into
# App settings -> Secrets in the Streamlit Cloud dashboard instead.

OPENROUTER_API_KEY = "your-openrouter-key-here"
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key-here"
